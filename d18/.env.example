# Anthropic API Key
# Get your key from https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-api03-tXC0cxxxxxxxxxxxxxxxxxxxxx
# Generate from https://airtable.com/create/tokens
# Required scopes: schema.bases:read, data.records:read
# (+ data.records:write for refund/escalate operations)
AIRTABLE_MCP_TOKEN=pat03aQT1mLIuxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Airtable "Support Desk" base -- which records the agent reads.
# Kept here, not in code, so pointing the demo at a different base is a
# config change and nothing else.
AIRTABLE_BASE_ID=appigg5gXRw1BQNGl
AIRTABLE_CUSTOMERS_TABLE=tblIMOSWLudqGBTCi
AIRTABLE_ORDERS_TABLE=tbluv1N4YWNqUS5yt

# The MCP server this agent connects to. Swap this URL and the agent has
# entirely different powers -- that is the whole point of a standard protocol.
AIRTABLE_MCP_URL=https://mcp.airtable.com/mcp
